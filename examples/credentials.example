# PLACEHOLDERS ONLY! Never add real credentials to this repository.
# Copy the section into C:\Users\<you>\.aws\credentials.
# Use your ACTIVE Learner Lab values from AWS Details > AWS CLI > Show.
[academy]
aws_access_key_id = <PASTE_TEMPORARY_ACCESS_KEY>
aws_secret_access_key = <PASTE_TEMPORARY_SECRET_KEY>
aws_session_token = <PASTE_TEMPORARY_SESSION_TOKEN>
